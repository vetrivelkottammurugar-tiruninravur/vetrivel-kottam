{
  "id": "./index.html",
  "name": "Murugar Temple Manager",
  "short_name": "Temple",
  "description": "Devotees, donations, pooja bookings and WhatsApp / SMS alerts for Vetrivel Kottam, Thiruninravur",
  "lang": "en",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbf6ee",
  "theme_color": "#8c2410",
  "categories": ["productivity", "business"],
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Scan notebook", "short_name": "Scan", "url": "./index.html?go=scan"},
    {"name": "Add donation", "short_name": "Donation", "url": "./index.html?go=donation"},
    {"name": "New booking", "short_name": "Booking", "url": "./index.html?go=booking"},
    {"name": "Today's reminders", "short_name": "Reminders", "url": "./index.html?go=alerts"}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{"name": "media", "accept": ["image/*", ".jpg", ".jpeg", ".png"]}]
    }
  }
}
